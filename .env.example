# .env.example — copy this to .env and fill in your actual values
# NEVER commit .env to git — it contains live API keys.

# Groq API key for LLM failure diagnosis (llama-3.3-70b-versatile)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Discord Incoming Webhook URL for critical scraper failure alerts
# Create one at: Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN